<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Background Image Utama (Selalu Fixed di Layar Belakang Paling Atas) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_gravity="top"
        android:src="@drawable/download_img"
        android:contentDescription="Background App Utama" />

    <!-- Soft Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12000000" />

    <!-- Decorative Corner Sticker 1 (Top Left) -->
    <ImageView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/lampiran2"
        android:alpha="0.95"
        android:contentDescription="Stiker Hiasan Daun" />

    <!-- Decorative Corner Sticker 2 (Top Right) -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_lampiran1"
        android:alpha="0.95"
        android:contentDescription="Stiker Hiasan Bintang" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal">

                <!-- Foto Profil Tengah: lampiran3 -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lampiran3"
                    android:contentDescription="Foto Profil Utama"
                    android:layout_marginBottom="12dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#EAE3D2"
                    app:shapeAppearanceOverlay="@style/CircularImageViewStyle" />

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aizat Fahim Firmansyah"
                    android:textColor="#2D2A26"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Developer &amp; Portfolio"
                    android:textColor="#6E675F"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Section: Kontak Header dengan Stiker Hiasan -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Kontak"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3D3833" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lampiran2"
                    android:contentDescription="Stiker Daun Tulis" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Lokasi Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:onClick="openMapsIntent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location"
                        android:contentDescription="Lokasi" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lokasi"
                            android:textSize="12sp"
                            android:textColor="#8C8377" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gumpang Soditan"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D2A26" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maps ➔"
                        android:textColor="#4A6984"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAE3D2" />

                <!-- WhatsApp Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:onClick="openWhatsAppIntent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_whatsapp"
                        android:contentDescription="WhatsApp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WhatsApp"
                            android:textSize="12sp"
                            android:textColor="#8C8377" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+62 859-4668-9168"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D2A26" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat ➔"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAE3D2" />

                <!-- Portofolio Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:onClick="openPortfolioIntent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_link"
                        android:contentDescription="Portofolio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Portofolio"
                            android:textSize="12sp"
                            android:textColor="#8C8377" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="firtofolio.vercel.app"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D2A26" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buka ➔"
                        android:textColor="#4A6984"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Section: Projects Header dengan Stiker -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Project"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3D3833" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bg_lampiran1"
                    android:contentDescription="Stiker Hiasan" />
            </RelativeLayout>

            <!-- Card Project Focus Clock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Clock"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2D2A26" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="focus-clock-web.vercel.app"
                    android:textSize="12sp"
                    android:textColor="#6E675F"
                    android:layout_marginTop="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Buka Web"
                    android:textSize="12sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="openFocusClockWeb" />
            </LinearLayout>

            <!-- Card Valeska -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valeska"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2D2A26" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="valeska.zafir.my.id (Virtual Agent)"
                    android:textSize="12sp"
                    android:textColor="#6E675F"
                    android:layout_marginTop="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Buka Agent"
                    android:textSize="12sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="openValeskaAgent" />
            </LinearLayout>

            <!-- Card Qurabic -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qurabic"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2D2A26" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="qurabic-indo-corpus.vercel.app"
                    android:textSize="12sp"
                    android:textColor="#6E675F"
                    android:layout_marginTop="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Buka Corpus"
                    android:textSize="12sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="openQurabicCorpus" />
            </LinearLayout>

            <!-- Card Rync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rync"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2D2A26" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rync.zafir.my.id"
                    android:textSize="12sp"
                    android:textColor="#6E675F"
                    android:layout_marginTop="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Buka Rync"
                    android:textSize="12sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="openRync" />
            </LinearLayout>

            <!-- Card Sadar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sadar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2D2A26" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sadar-web.vercel.app"
                    android:textSize="12sp"
                    android:textColor="#6E675F"
                    android:layout_marginTop="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Buka Web"
                    android:textSize="12sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="openSadarWeb" />
            </LinearLayout>

            <!-- Card GitHub -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GitHub"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#2D2A26" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="github.com/aizatfahim"
                    android:textSize="12sp"
                    android:textColor="#6E675F"
                    android:layout_marginTop="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="Buka GitHub"
                    android:textSize="12sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="openGithubProfile" />
            </LinearLayout>

            <!-- Section: Dokumen Header dengan Stiker -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Dokumen"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3D3833" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lampiran2"
                    android:contentDescription="Stiker Bintang" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_preset_paper"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Paper Focus Clock"
                        android:textSize="11sp"
                        android:backgroundTint="#6E675F"
                        android:textColor="#FAF8F5"
                        android:onClick="loadPaperTemplate" />

                    <Button
                        android:id="@+id/btn_preset_profile"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Ringkasan Profil"
                        android:textSize="11sp"
                        android:backgroundTint="#6E675F"
                        android:textColor="#FAF8F5"
                        android:onClick="loadProfileTemplate" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_share_document"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_input_card"
                    android:gravity="top|start"
                    android:hint="Tuliskan catatan atau dokumen..."
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:inputType="textMultiLine"
                    android:autofillHints="none" />

                <Button
                    android:id="@+id/btn_share_document"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="Bagikan Dokumen"
                    android:textSize="13sp"
                    android:backgroundTint="#4A443F"
                    android:textColor="#FAF8F5"
                    android:onClick="shareDocumentIntent" />

            </LinearLayout>

            <!-- Section: Pesan Chat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3D3833"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clean_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/editTextUsername"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Nama Anda"
                    android:text="Aizat Fahim Firmansyah"
                    android:textSize="13sp"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_message_card"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/text_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Belum ada pesan."
                        android:textSize="13sp"
                        android:textColor="#2D2A26" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editText"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_card"
                        android:hint="Ketik pesan..."
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="text"
                        android:textSize="13sp"
                        android:autofillHints="none" />

                    <Button
                        android:id="@+id/button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="Kirim"
                        android:textSize="12sp"
                        android:backgroundTint="#4A443F"
                        android:textColor="#FAF8F5"
                        android:onClick="openSecondActivity" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>